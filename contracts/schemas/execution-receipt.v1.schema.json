{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scos.pro/schemas/execution-receipt.v1.schema.json",
  "title": "SCOS Execution Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "intent_id", "decision_id", "workflow_id", "action_id", "provider_id", "status", "started_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "receipt_id": { "type": "string" },
    "intent_id": { "type": "string" },
    "decision_id": { "type": "string" },
    "workflow_id": { "type": "string" },
    "action_id": { "type": "string" },
    "provider_id": { "type": "string" },
    "provider_operation_id": { "type": "string" },
    "status": { "enum": ["accepted", "running", "succeeded", "failed", "cancelled", "unknown"] },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "artifact_refs": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "verification_status": { "enum": ["not_checked", "verified", "partially_verified", "failed_verification"] },
    "error_code": { "type": "string" },
    "error_summary": { "type": "string" }
  }
}