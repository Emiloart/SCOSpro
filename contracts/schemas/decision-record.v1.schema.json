{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scos.pro/schemas/decision-record.v1.schema.json",
  "title": "SCOS Decision Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "intent_id", "status", "options", "selected_option_id", "assessment_refs", "dissent", "confidence", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "decision_id": { "type": "string" },
    "intent_id": { "type": "string" },
    "status": { "enum": ["proposed", "awaiting_policy", "awaiting_human", "authorized", "rejected", "deferred", "superseded"] },
    "options": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["option_id", "description", "consequences"], "properties": { "option_id": { "type": "string" }, "description": { "type": "string" }, "consequences": { "type": "array", "items": { "type": "string" } }, "estimated_cost": { "type": ["number", "null"] }, "risk_level": { "enum": ["low", "moderate", "high", "critical"] } } } },
    "selected_option_id": { "type": ["string", "null"] },
    "rationale": { "type": "string" },
    "assessment_refs": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "dissent": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["council_id", "position"], "properties": { "council_id": { "type": "string" }, "position": { "type": "string" }, "reason": { "type": "string" } } } },
    "unresolved_questions": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "policy_decision_ref": { "type": "string" },
    "human_approver_ref": { "type": "string" },
    "review_after": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}