{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scos.pro/schemas/policy-decision.v1.schema.json",
  "title": "SCOS Policy Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_decision_id", "subject_id", "tenant_id", "action", "result", "reason_codes", "policy_version", "evaluated_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "policy_decision_id": { "type": "string" },
    "subject_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "action": { "type": "string" },
    "result": { "enum": ["allow", "deny", "require_approval", "defer"] },
    "reason_codes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "policy_version": { "type": "string" },
    "required_approver_roles": { "type": "array", "items": { "type": "string" } },
    "conditions": { "type": "array", "items": { "type": "string" } },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "evaluated_at": { "type": "string", "format": "date-time" }
  }
}