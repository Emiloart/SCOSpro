{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scos.pro/schemas/council-assessment.v1.schema.json",
  "title": "SCOS Council Assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment_id", "decision_id", "council_id", "mandate", "recommendation", "findings", "uncertainties", "confidence", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "assessment_id": { "type": "string" },
    "decision_id": { "type": "string" },
    "council_id": { "type": "string" },
    "mandate": { "type": "string", "minLength": 1 },
    "model_lineage": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["provider", "model"], "properties": { "provider": { "type": "string" }, "model": { "type": "string" }, "version": { "type": "string" }, "independence_group": { "type": "string" } } } },
    "recommendation": { "enum": ["support", "oppose", "conditional_support", "abstain", "request_information"] },
    "findings": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["statement", "kind"], "properties": { "statement": { "type": "string", "minLength": 1 }, "kind": { "enum": ["fact", "inference", "hypothesis", "risk", "opportunity"] }, "evidence_refs": { "type": "array", "items": { "type": "string" } } } } },
    "alternatives": { "type": "array", "items": { "type": "string" } },
    "objections": { "type": "array", "items": { "type": "string" } },
    "uncertainties": { "type": "array", "items": { "type": "string" } },
    "required_conditions": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence_basis": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}